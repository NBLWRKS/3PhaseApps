# Reference for environment variables. On Render, set these in each service's
# Environment tab (or via render.yaml) rather than committing a .env file.

# ---- API service (phasemaster-api) ----
JWT_SECRET=generate-a-strong-random-string   # openssl rand -hex 32
PUBLIC_URL=https://phasemaster-api.onrender.com      # this API's own URL
CORS_ORIGIN=https://phasemaster-web.onrender.com     # the frontend's URL
DATA_DIR=/var/data/db                          # on the mounted persistent disk
UPLOAD_DIR=/var/data/uploads                   # on the mounted persistent disk
OPEN_SIGNUP=true
REQUIRE_OTP=false
# ANTHROPIC_API_KEY=sk-ant-...                 # optional: enables translation

# ---- Keep-alive (free-tier anti-spindown) ----
# Free Render services sleep after ~15 min idle. With these set, the server
# pings its own public /api/health to stay awake. KEEP_ALIVE_URL should be the
# service's PUBLIC url (Render must see inbound traffic for it to count).
KEEP_ALIVE=true
KEEP_ALIVE_URL=https://phasemaster-api.onrender.com
KEEP_ALIVE_MINUTES=12                          # interval; keep under ~15


# ---- Static site (phasemaster-web), build-time ----
VITE_API_BASE=https://phasemaster-api.onrender.com/api   # note the /api suffix
